# Shim: emulate `claude -p ... --dangerously-skip-permissions --max-turns N --model M`
# by driving OpenAI Codex (>=0.145) against frontier GPT-5.5 on Amazon Bedrock via
# Codex's BUILT-IN amazon-bedrock provider.
#
#   claude --dangerously-skip-permissions --max-turns N --model M -p "<prompt>"
# maps to:
#   codex -a never [-c ...] exec --skip-git-repo-check -C "$PWD" -m openai.gpt-5.5 \
#         -s <sandbox> "<prompt>" < /dev/null
#
# Env knobs:
#   CODEX_GPT_MODEL   Bedrock model id (default openai.gpt-5.5)
#   CODEX_TIMEOUT     hard wall-clock timeout in seconds (default 900)
#   CODEX_SANDBOX     sandbox mode (default workspace-write)
#   AWS_REGION        Bedrock region (default us-east-2)

set -o pipefail

PROMPT=""
while [ $# -gt 0 ]; do
  case "$1" in
    -p|--print)                       PROMPT="$2"; shift 2 ;;
    --max-turns)                      shift 2 ;;   # emulated by timeout backstop
    --model)                          shift 2 ;;   # model from config / this shim
    --dangerously-skip-permissions)   shift ;;
    --output-format|--input-format|--permission-mode) shift 2 ;;
    *)
      if [ -z "$PROMPT" ] && [ "${1:0:1}" != "-" ]; then PROMPT="$1"; fi
      shift ;;
  esac
done
[ -z "$PROMPT" ] && PROMPT="$(cat)"

MODEL="${CODEX_GPT_MODEL:-openai.gpt-5.5}"
TIMEOUT="${CODEX_TIMEOUT:-900}"
REGION="${AWS_REGION:-us-east-2}"
SANDBOX="${CODEX_SANDBOX:-workspace-write}"

CODEX_BIN="$HOME/.local/bin/codex"
[ -x "$CODEX_BIN" ] || CODEX_BIN="$(command -v codex)"

export AWS_REGION="$REGION"

# Resolve the workdir to its REAL path. Codex's workspace-write sandbox whitelists
# the literal --cd path, but .git operations resolve through symlinks to the real
# path; if the caller cd'd via a symlink (e.g. nyc-311 -> experiments/nyc-311), git
# writes get blocked as "read-only". Passing the realpath fixes that.
WORKDIR="$(cd "$PWD" && pwd -P)"

# Point uv at a writable cache inside the sandbox-writable tree (default
# ~/.cache/uv is read-only under the sandbox, breaking `uv run`).
export UV_CACHE_DIR="${UV_CACHE_DIR:-/tmp/uv-cache-codexshim}"
mkdir -p "$UV_CACHE_DIR" 2>/dev/null

# Built-in amazon-bedrock provider; network enabled for workspace-write so uv can
# install deps. Global flags precede `exec` in Codex >=0.145.
timeout "$TIMEOUT" "$CODEX_BIN" -a never \
  -c model_provider='"amazon-bedrock"' \
  -c sandbox_workspace_write.network_access=true \
  exec --skip-git-repo-check \
  -C "$WORKDIR" -m "$MODEL" -s "$SANDBOX" \
  "$PROMPT" < /dev/null
RC=$?
if [ $RC -eq 124 ]; then
  echo "[claude-shim] TIMEOUT after ${TIMEOUT}s (codex killed)" >&2
fi
exit $RC
